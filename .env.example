# Application Configuration
APP_NAME="FastAPI AWS Cloud Application"
APP_ENV=production
DEBUG=False
PORT=8000

# AWS RDS PostgreSQL Configuration (Task 2.1 & 2.2)
# DB Instance Identifier: fast-api-db
# Database Name: fastapi-prod
DB_HOST=fast-api-db.xxxxxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YourSecurePassword123!
DB_NAME=fastapi-prod

# Full RDS Connection String (Task 6.2 secret DATABASE_URL)
DATABASE_URL=postgresql://postgres:YourSecurePassword123!@fast-api-db.xxxxxxxxx.ap-southeast-1.rds.amazonaws.com:5432/fastapi-prod

# AWS Configuration (Task 1.1, 1.3, 3.1)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS S3 Storage (Task 3.1)
# Bucket format: fastapi-app-files-<your-id>
S3_BUCKET_NAME=fastapi-app-files-yourname123
S3_FOLDER=uploads/
