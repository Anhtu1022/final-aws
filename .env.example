# Application Configuration
APP_NAME="FastAPI AWS Cloud Application"
APP_ENV=production
DEBUG=False
PORT=8000

# AWS RDS PostgreSQL Configuration
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_HOST=your-rds-endpoint.xxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YourSecurePassword123!
DB_NAME=fastapi_db

# Direct Database URL (optional override; if not set, constructed from DB_* vars above)
DATABASE_URL=postgresql://postgres:YourSecurePassword123!@your-rds-endpoint.xxxxxxx.us-east-1.rds.amazonaws.com:5432/fastapi_db

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
S3_BUCKET_NAME=your-unique-s3-bucket-name
S3_FOLDER=uploads/
