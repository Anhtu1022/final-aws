# Application Configuration
APP_NAME="FastAPI AWS Cloud Application"
APP_ENV=production
DEBUG=False
PORT=8000

# Database Configuration
DB_HOST=fast-api-db.xxxxxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YourSecurePassword123!
DB_NAME=fastapiprod

DATABASE_URL=postgresql+psycopg2://postgres:YourSecurePassword123!@fast-api-db.xxxxxxxxx.ap-southeast-1.rds.amazonaws.com:5432/fastapiprod

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# S3 Storage Configuration
S3_BUCKET_NAME=fastapi-app-files-tunta5
S3_FOLDER=uploads/
